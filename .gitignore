# Raw ACS / law-school data files (large, not versioned)
data/acs/
data/atherosclerosis.*
data/*.csv
data/*.xls
# Keep data/*.py (the Python data-loading package)

# Hydra run outputs
.hydra/

# Regenerable binary artifacts
__pycache__/
*.pyc
*.pyo

# Preprocessed tensors — regenerable from data/
outputs/data/

# Candidate caches — regenerable from sweep script
outputs/recourse/*.pkl

# Trained model artifacts — regenerable from the pipeline
outputs/**/*.pt
outputs/**/*.joblib

# Run logs
*.log

# Python tooling
.venv/
*.egg-info/
dist/
build/
.env
